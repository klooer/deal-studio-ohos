build/
.hvigor/
.vscode/
node_modules/
oh_modules/
/tmp/
/entry/.cxx/
local.properties
results/*.prev

# The device catalogue never belongs here.
#
# A row in it names an ability, a constant and a versionCode belonging to one
# phone and one firmware -- the operator's material, established by reading what
# is installed on their device. The product ships the rows that come from
# Huawei's published specification (VeraIntentCatalog.ets) and the loader that
# reads the rest from {filesDir}/vera/intent-catalog.json at run time.
intent-catalog*.json
intent-candidates*.json
*.catalog.json
rows.ets.txt

# Anything pulled off a phone, for the same reason.
*.hap
*.hsp
insight_intent*.db

# Python bytecode from the host-side tools.
__pycache__/

# llama.cpp source -- cloned per entry/src/main/cpp/CMakeLists.txt's own
# comment (`git clone --depth 1 https://github.com/ggml-org/llama.cpp`), not
# vendored. Same for its native build cache.
entry/src/main/cpp/llama.cpp/
entry/src/main/cpp/build-host/

# GGUF model weights -- downloaded on first run (LlamaEngine.ets,
# VeraEmbeddings.ets), never committed.
*.gguf

# tsc's own output for the host harness (tools/vera-harness) -- regenerate with
# `tsc -p tools/vera-harness/tsconfig.json`, per tools/vera-harness/README.md.
tools/vera-harness/out/
.deepseekkey
.jevkey
